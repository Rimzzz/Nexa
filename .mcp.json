{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-filesystem", "/home/ubuntu/project/Nexa"]
    },
    "figma": {
      "command": "node",
      "args": ["/home/ubuntu/project/Nexa/scripts/figma-mcp-server.js"],
